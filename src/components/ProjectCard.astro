---
import type { CollectionEntry } from 'astro:content';
import { categoryAccent } from '../lib/accent';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  big?: boolean;
  class?: string;
}

const { project, index, big = false, class: className } = Astro.props;
const d = project.data;
const acc = categoryAccent[d.category];
const tags = d.tags.slice(0, big ? 7 : 4);
---

<a
  href={`/projects/${project.id}`}
  class:list={["card group flex flex-col no-underline h-full", big ? "p-7 md:p-10" : "p-6 md:p-7", className]}
  style={`--acc: ${acc};`}
  data-category={d.category}
>
  <span class="acc-bar" aria-hidden="true"></span>

  <!-- Big decorative glow for the hero card -->
  {big && <span class="big-glow" aria-hidden="true"></span>}

  <div class="flex items-center justify-between gap-3">
    <span class="chip chip-acc">{d.category}</span>
    <span class="arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
    </span>
  </div>

  <ProjectMedia
    project={project}
    class:list={["mt-5", big && "md:mt-7"]}
    sizes={big ? '(min-width: 1024px) 760px, 100vw' : '(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw'}
  />

  <div class:list={["mt-6", big && "md:mt-8"]}>
    {index !== undefined && (
      <p class="font-mono text-[12px] mb-2" style="color: var(--dim);">{String(index).padStart(2, '0')} — {d.period}</p>
    )}
    <h3 class:list={["font-display font-extrabold tracking-[-0.035em] leading-[1.02]", big ? "text-[clamp(34px,4.4vw,58px)]" : "text-[26px] md:text-[28px]"]} style="color: var(--ink);">
      {d.title}
    </h3>
    <p class:list={["mt-3 leading-relaxed", big ? "text-[17px] md:text-[19px] max-w-[46ch]" : "text-[15px]"]} style="color: var(--muted);">
      {d.subtitle}
    </p>
    <p class="mt-3 text-[13px] font-mono" style="color: var(--dim);">
      {d.context}{d.role ? ` · ${d.role}` : d.team ? ` · ${d.team}` : ''}
    </p>
  </div>

  {big && d.metrics && (
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
      {d.metrics.map((m) => (
        <div class="metric">
          <div class="stat-value text-[34px] md:text-[40px]" style="color: var(--acc);">{m.value}</div>
          <div class="mt-1.5 text-[12.5px] leading-snug" style="color: var(--muted);">{m.label}</div>
        </div>
      ))}
    </div>
  )}

  <div class="mt-auto pt-6 flex flex-wrap gap-2">
    {tags.map((t) => <span class="chip">{t}</span>)}
  </div>
</a>

<style>
  .arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line-strong); color: var(--ink);
    transition: transform .4s cubic-bezier(.16,1,.3,1), background .3s, color .3s, border-color .3s;
  }
  .group:hover .arrow { transform: rotate(45deg); background: var(--acc); border-color: var(--acc); color: #fff; }
  .metric {
    padding: 14px 16px; border-radius: 18px;
    background: color-mix(in oklab, var(--acc) 9%, transparent);
    border: 1px solid color-mix(in oklab, var(--acc) 25%, transparent);
  }
  .big-glow {
    position: absolute; z-index: -1; right: -12%; bottom: -30%;
    width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--acc) 45%, transparent), transparent 65%);
    filter: blur(30px); opacity: .55;
    pointer-events: none;
    max-width: 100%;
  }
</style>
