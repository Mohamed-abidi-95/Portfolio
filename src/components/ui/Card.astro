---
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div class={cn("rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] shadow-sm transition-all hover:shadow-md hover:border-[var(--color-accent-muted)]", className)} {...rest}>
  <slot />
</div>
