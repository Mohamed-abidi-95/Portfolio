---
import { cn } from "../../lib/utils";

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const baseStyles = "inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-50 disabled:pointer-events-none ring-offset-bg-color";

const variants = {
  primary: "bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] px-4 py-2 text-sm",
  secondary: "bg-[var(--card-bg)] text-[var(--text-primary)] hover:bg-[var(--border-color)] px-4 py-2 text-sm border border-[var(--border-color)]",
  outline: "border border-[var(--color-accent)] text-[var(--color-accent)] hover:bg-[var(--color-accent-muted)] px-4 py-2 text-sm",
};
---

{
  href ? (
    <a href={href} class={cn(baseStyles, variants[variant], className)} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={cn(baseStyles, variants[variant], className)} {...rest}>
      <slot />
    </button>
  )
}
