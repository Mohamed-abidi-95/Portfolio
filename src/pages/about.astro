---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person, experiences, education, languages, softSkills, skillGroups } from '../data/profile';

const timeline = [
  ...experiences.map((e) => ({ when: e.period, title: e.company, sub: e.role, color: e.color, kind: 'Internship' })),
  ...education.map((e, i) => ({ when: e.period, title: e.school, sub: e.degree, color: ['var(--pink)', 'var(--cyan)', 'var(--lime)'][i], kind: 'Education' })),
];
---

<BaseLayout title="About — Mohamed Abidi">
  <div class="mesh opacity-70" aria-hidden="true"><div class="blob b1"></div><div class="blob b3"></div></div>

  <div class="wrap relative z-10 pb-24">
    <!-- Intro -->
    <section class="grid lg:grid-cols-[1.3fr_0.7fr] gap-12 items-end">
      <div>
        <p class="eyebrow rise rise-1">About</p>
        <h1 class="h-display mt-5 text-[clamp(52px,9vw,124px)] rise rise-2">
          <span style="color: var(--ink);">Hi, I'm </span><span class="grad-text">Mohamed.</span>
        </h1>
        <p class="mt-8 text-[clamp(19px,2.2vw,24px)] leading-snug max-w-[46ch] rise rise-3" style="color: var(--ink);">
          {person.summary}
        </p>
        <p class="mt-5 text-[17px] leading-relaxed max-w-[56ch] rise rise-4" style="color: var(--muted);">
          My goal: {person.goal.charAt(0).toLowerCase() + person.goal.slice(1)}
        </p>
      </div>

      <div class="card p-7 rise rise-5" style="--acc: var(--lime);">
        <span class="acc-bar" aria-hidden="true"></span>
        <div class="flex items-center gap-3"><span class="live-dot" aria-hidden="true"></span><span class="font-semibold" style="color: var(--ink);">Available</span></div>
        <p class="mt-4 font-display font-bold text-[26px] leading-tight tracking-tight" style="color: var(--ink);">{person.lookingFor}</p>
        <p class="mt-2 text-[15px]" style="color: var(--muted);">{person.availability.charAt(0).toUpperCase() + person.availability.slice(1)}</p>
        <div class="mt-5 flex flex-wrap gap-2">{person.countries.map((c) => <span class="chip">{c}</span>)}</div>
        <p class="mt-5 text-[13px] font-mono" style="color: var(--dim);">Based in {person.location}</p>
      </div>
    </section>

    <!-- Timeline -->
    <section class="section !pb-0">
      <p class="eyebrow reveal">Path</p>
      <h2 class="h-section mt-4 reveal d1">From business computing <span class="grad-text">to AI engineering.</span></h2>

      <ol class="timeline mt-12">
        {timeline.map((t, i) => (
          <li class:list={["reveal", `d${(i % 3) + 1}`]} style={`--c: ${t.color};`}>
            <span class="dot" aria-hidden="true"></span>
            <div class="card lift p-6 md:p-7" style={`--acc: ${t.color};`}>
              <div class="flex flex-wrap items-center gap-3">
                <span class="chip chip-acc">{t.when}</span>
                <span class="font-mono text-[12px] uppercase tracking-[.14em]" style="color: var(--dim);">{t.kind}</span>
              </div>
              <h3 class="mt-4 font-display font-extrabold text-[24px] md:text-[28px] tracking-[-0.03em] leading-tight" style="color: var(--ink);">{t.title}</h3>
              <p class="mt-1 text-[15.5px]" style="color: var(--muted);">{t.sub}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section class="section !pb-0">
      <p class="eyebrow reveal">Skills</p>
      <h2 class="h-section mt-4 reveal d1">Technical <span class="grad-text">skills</span>.</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map((g, i) => (
          <div class:list={["card lift p-6 reveal", `d${(i % 3) + 1}`]} style={`--acc: ${g.color};`}>
            <span class="acc-bar" aria-hidden="true"></span>
            <h3 class="font-display font-bold text-[20px] tracking-tight" style={`color: ${g.color};`}>{g.name}</h3>
            <div class="mt-4 flex flex-wrap gap-2">{g.items.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Languages & soft skills -->
    <section class="section !pb-0 grid gap-5 lg:grid-cols-2">
      <div class="card p-7 md:p-9 reveal" style="--acc: var(--violet);">
        <span class="acc-bar" aria-hidden="true"></span>
        <h2 class="font-display font-extrabold text-[30px] tracking-[-0.03em]" style="color: var(--ink);">Languages</h2>
        <div class="mt-6 space-y-5">
          {languages.map((l) => (
            <div>
              <div class="flex justify-between text-[15px]"><span class="font-semibold" style="color: var(--ink);">{l.name}</span><span class="font-mono" style="color: var(--dim);">{l.level}</span></div>
              <div class="mt-2 h-2.5 rounded-full overflow-hidden" style="background: var(--line);">
                <div class="h-full rounded-full" style={`width: ${l.pct}%; background: var(--grad);`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="card p-7 md:p-9 reveal d1" style="--acc: var(--orange);">
        <span class="acc-bar" aria-hidden="true"></span>
        <h2 class="font-display font-extrabold text-[30px] tracking-[-0.03em]" style="color: var(--ink);">How I work</h2>
        <div class="mt-6 grid grid-cols-2 gap-3">
          {softSkills.map((s, i) => (
            <div class="soft" style={`--c: ${['var(--violet)', 'var(--pink)', 'var(--orange)', 'var(--cyan)'][i % 4]};`}>{s}</div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={person.cv} download="Mohamed-Abidi-CV.pdf" class="btn btn-grad">Download CV ↓</a>
          <a href="/contact" class="btn btn-ghost">Contact</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .timeline { position: relative; display: grid; gap: 18px; padding-left: 34px; }
  .timeline::before {
    content: ""; position: absolute; left: 9px; top: 8px; bottom: 8px; width: 3px; border-radius: 3px;
    background: linear-gradient(var(--violet), var(--pink), var(--orange), var(--cyan), var(--lime));
  }
  .timeline li { position: relative; }
  .timeline .dot {
    position: absolute; left: -34px; top: 30px; width: 21px; height: 21px; border-radius: 50%;
    background: var(--bg); border: 4px solid var(--c); box-shadow: 0 0 18px var(--c);
  }
  .soft {
    padding: 16px; border-radius: 18px; font-weight: 650; font-size: 15.5px;
    color: var(--ink);
    background: color-mix(in oklab, var(--c) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--c) 35%, transparent);
  }
</style>
