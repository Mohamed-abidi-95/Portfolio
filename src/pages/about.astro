---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import { skillCategories } from '../data/skills';
import { experiences, educationList, certificationsList } from '../data/experience';
import { ExternalLink } from 'lucide-react';
---

<BaseLayout title="About | Mohamed Abidi">
  <div class="container mx-auto px-4 max-w-4xl">
    
    <header class="mb-14">
      <div class="flex items-center gap-3 mb-3">
        <div class="section-line"></div>
        <span class="text-[11px] tracking-[0.16em] uppercase font-mono font-semibold" style="color: var(--color-accent);">Profile & Background</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6" style="color: var(--text-primary);">About Me</h1>
      <p class="text-lg md:text-xl leading-relaxed" style="color: var(--text-muted);">
        I am an engineering student in Data Science & AI (3rd year at ESPRIM) with hands-on industrial and enterprise project experience. I bridge the gap between machine learning concepts and robust software engineering to deliver end-to-end AI systems.
      </p>
    </header>

    <div class="grid md:grid-cols-3 gap-12">
      <div class="md:col-span-2 space-y-16">
        
        {/* Experience Timeline */}
        <section>
          <h2 class="text-2xl font-bold tracking-tight mb-8 flex items-center gap-3" style="color: var(--text-primary);">
            Experience
          </h2>
          <div class="space-y-10 pl-5 border-l-2" style="border-color: var(--color-accent-border);">
            {experiences.map(exp => (
              <div class="relative pl-5">
                <div
                  class="absolute w-3 h-3 rounded-full border-2"
                  style={{
                    background: 'var(--bg-color)',
                    borderColor: 'var(--color-accent)',
                    left: '-27px',
                    top: '6px',
                  }}
                />
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1.5">
                  <h3 class="text-lg font-bold" style={{ color: 'var(--text-primary)' }}>{exp.role}</h3>
                  <span class="text-xs font-mono" style={{ color: 'var(--text-dim)' }}>{exp.date}</span>
                </div>
                <div class="text-sm font-semibold mb-3" style={{ color: 'var(--color-accent)' }}>{exp.company}</div>
                <ul class="list-disc list-inside text-xs leading-relaxed space-y-2" style={{ color: 'var(--text-muted)' }}>
                  {exp.bullets.map(bullet => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        {/* Education */}
        <section>
          <h2 class="text-2xl font-bold tracking-tight mb-8" style="color: var(--text-primary);">Education</h2>
          <div class="grid gap-4">
            {educationList.map(edu => (
              <div
                class="p-5 rounded-xl border transition-colors"
                style={{
                  background: 'var(--bg-card)',
                  borderColor: 'var(--border-card)',
                  boxShadow: 'var(--card-shadow)',
                }}
              >
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-1.5">
                  <h3 class="font-bold text-sm md:text-base" style={{ color: 'var(--text-primary)' }}>{edu.degree}</h3>
                  <span
                    class="px-2.5 py-0.5 rounded text-[11px] font-mono w-fit font-semibold"
                    style={{
                      background: 'var(--color-accent-soft)',
                      color: 'var(--color-accent)',
                      border: '1px solid var(--color-accent-border)',
                    }}
                  >
                    {edu.date}
                  </span>
                </div>
                <div class="text-xs font-medium" style={{ color: 'var(--text-muted)' }}>{edu.institution}</div>
              </div>
            ))}
          </div>
        </section>

      </div>
      
      <div class="space-y-12">
        {/* Skills Grid */}
        <section>
          <h2 class="text-2xl font-bold tracking-tight mb-6" style="color: var(--text-primary);">Skill Domains</h2>
          <div class="space-y-6">
            {skillCategories.map(category => (
              <div>
                <h3 class="text-xs font-mono font-bold uppercase tracking-wider mb-3 pb-1 border-b" style={{ color: 'var(--color-accent)', borderColor: 'var(--border-color)' }}>
                  {category.domain}
                </h3>
                <div class="space-y-2.5">
                  {category.skills.map(skill => (
                    <div>
                      <div class="text-xs font-semibold" style={{ color: 'var(--text-primary)' }}>{skill.name}</div>
                      <div class="text-[11px] leading-tight" style={{ color: 'var(--text-muted)' }}>
                        {skill.context}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* Certifications */}
        <section>
          <h2 class="text-2xl font-bold tracking-tight mb-6" style="color: var(--text-primary);">Certifications</h2>
          <div class="space-y-3">
            {certificationsList.map(cert => (
              <div
                class="p-3.5 rounded-xl border flex items-center justify-between transition-colors"
                style={{
                  background: 'var(--bg-card)',
                  borderColor: 'var(--border-card)',
                  boxShadow: 'var(--card-shadow)',
                }}
              >
                <div>
                  <div class="font-bold text-xs" style={{ color: 'var(--text-primary)' }}>{cert.title}</div>
                  <div class="text-[11px] font-mono mt-0.5" style={{ color: 'var(--text-muted)' }}>
                    {cert.issuer} {cert.date ? `· ${cert.date}` : ''}
                  </div>
                </div>
                <span
                  class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold"
                  style={{
                    background: 'var(--color-accent-soft)',
                    color: 'var(--color-accent)',
                    border: '1px solid var(--color-accent-border)',
                  }}
                >
                  Verified
                </span>
              </div>
            ))}
          </div>
        </section>

        {/* Languages */}
        <section>
          <h2 class="text-2xl font-bold tracking-tight mb-4" style="color: var(--text-primary);">Languages</h2>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-mono border" style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-primary);">
              English (B2)
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-mono border" style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-primary);">
              French (B2)
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-mono border" style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-primary);">
              Arabic (Native)
            </span>
          </div>
        </section>

      </div>
    </div>
  </div>
</BaseLayout>
