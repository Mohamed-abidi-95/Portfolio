---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RagDemo } from '../components/lab/RagDemo';
---

<BaseLayout title="AI Lab | Mohamed Abidi">
  <div class="container mx-auto px-4 max-w-4xl">
    
    <header class="mb-14">
      <div class="flex items-center gap-3 mb-3">
        <div class="section-line"></div>
        <span class="text-[11px] tracking-[0.16em] uppercase font-mono font-semibold" style="color: var(--color-accent);">Research & Prototypes</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4" style={{ color: 'var(--text-primary)' }}>AI Lab</h1>
      <p class="text-lg md:text-xl leading-relaxed" style={{ color: 'var(--text-muted)' }}>
        Interactive demonstrations and technical explorations of applied AI concepts.
      </p>
    </header>

    <section class="mb-16">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        
        <div>
          <div class="inline-block px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold mb-3" style={{ background: 'var(--color-accent-soft)', color: 'var(--color-accent)', border: '1px solid var(--color-accent-border)' }}>
            Prototype · Simulation
          </div>
          <h2 class="text-2xl font-bold tracking-tight mb-4" style={{ color: 'var(--text-primary)' }}>Document Q&A (RAG)</h2>
          <p class="text-sm leading-relaxed mb-6" style={{ color: 'var(--text-muted)' }}>
            This is a simulated Retrieval-Augmented Generation (RAG) agent. In production environments, this pipeline employs pre-computed chunk embeddings of the corpus, hybrid dense-sparse vector search, and a low-latency LLM endpoint to formulate validated answers strictly grounded in source documents.
          </p>
          
          <h3 class="font-bold text-xs uppercase tracking-wider mb-3 font-mono" style={{ color: 'var(--color-accent)' }}>Architecture Blueprint</h3>
          <ul class="list-disc list-inside text-xs leading-relaxed space-y-2 mb-6" style={{ color: 'var(--text-muted)' }}>
            <li>Embeddings: BGE-m3 / text-embedding-3-small</li>
            <li>Storage: PostgreSQL pgvector / in-memory HNSW index</li>
            <li>Inference: Llama 3 8B / Claude 3.5 Haiku</li>
            <li>Security: RBAC audit logs + zero data retention agreements</li>
          </ul>
        </div>
        
        <div class="rounded-2xl overflow-hidden border" style={{ borderColor: 'var(--border-card)', boxShadow: 'var(--card-shadow)' }}>
          <RagDemo client:visible />
        </div>

      </div>
    </section>

  </div>
</BaseLayout>
