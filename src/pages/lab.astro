---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RagDemo } from '../components/lab/RagDemo';
import { ArchitectureVisualizer } from '../components/visualizer/ArchitectureVisualizer';
---

<BaseLayout title="AI Lab — Mohamed Abidi">
  <div class="mesh" aria-hidden="true"><div class="blob b1"></div><div class="blob b4"></div><div class="blob b2"></div></div>

  <div class="wrap relative z-10 pb-24">
    <header class="max-w-4xl">
      <p class="eyebrow rise rise-1" style="color: var(--cyan);">AI Lab</p>
      <h1 class="h-display mt-5 text-[clamp(52px,9vw,124px)] rise rise-2">
        <span style="color: var(--ink);">Play with </span><span class="grad-text">retrieval.</span>
      </h1>
      <p class="mt-6 text-[clamp(18px,2vw,22px)] leading-snug max-w-[52ch] rise rise-3" style="color: var(--muted);">
        Two small interactive pieces: a search engine over my CV that runs in your browser, and a walk-through of the video RAG pipeline I led in ResearchMind AI.
      </p>
    </header>

    <!-- Demo -->
    <section class="mt-16 grid grid-cols-1 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-10 items-start">
      <div class="reveal min-w-0">
        <span class="chip chip-acc" style="--acc: var(--cyan);">Live · in-browser</span>
        <h2 class="mt-5 font-display font-extrabold text-[clamp(32px,4vw,48px)] tracking-[-0.035em] leading-[1.02]" style="color: var(--ink);">Ask my CV</h2>
        <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--muted);">
          The same idea as <a href="/projects/legaltn" class="inline-link">LegalTN</a>, at a tiny scale: BM25 ranking over short passages from my CV, the source shown for every answer, and abstention when nothing scores high enough.
        </p>
        <ul class="mt-6 space-y-3 text-[15px]" style="color: var(--muted);">
          <li class="flex gap-3"><span class="tick" style="--c: var(--violet);">1</span>Your question is tokenized and matched against every passage.</li>
          <li class="flex gap-3"><span class="tick" style="--c: var(--pink);">2</span>BM25 scores each passage; matched words are highlighted.</li>
          <li class="flex gap-3"><span class="tick" style="--c: var(--orange);">3</span>Below the threshold, it answers "I don't know" instead of guessing.</li>
        </ul>
        <p class="mt-6 text-[13px] font-mono" style="color: var(--dim);">No LLM, no server: the answers are extracted, never generated.</p>
      </div>

      <div class="reveal d1 min-w-0">
        <RagDemo client:visible />
      </div>
    </section>

    <!-- Pipeline -->
    <section class="mt-24 reveal">
      <ArchitectureVisualizer client:visible />
      <p class="mt-5 text-[15px]" style="color: var(--muted);">
        Full write-up: <a href="/projects/researchmind" class="inline-link">ResearchMind AI case study →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .inline-link { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--cyan); text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .inline-link:hover { color: var(--cyan); }
  .tick {
    flex: none; width: 26px; height: 26px; border-radius: 9px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: #fff; background: var(--c);
  }

  /* ── RAG demo ── */
  :global(.rag) {
    display: flex; flex-direction: column;
    border-radius: 28px; overflow: hidden;
    background: var(--bg-elev); border: 1px solid var(--line-strong);
    box-shadow: 0 40px 80px -40px color-mix(in oklab, var(--cyan) 60%, transparent);
  }
  :global(.rag-head) {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 18px 22px; border-bottom: 1px solid var(--line);
    background: linear-gradient(100deg, color-mix(in oklab, var(--cyan) 14%, transparent), color-mix(in oklab, var(--violet) 12%, transparent));
  }
  :global(.rag-title) { font-family: var(--font-display); font-weight: 800; font-size: 20px; letter-spacing: -.02em; color: var(--ink); }
  :global(.rag-sub) { font-family: var(--font-mono); font-size: 12px; color: var(--dim); margin-top: 2px; }
  :global(.rag-badge) { font-family: var(--font-mono); font-size: 11.5px; padding: 5px 10px; border-radius: 999px; color: var(--cyan); border: 1px solid color-mix(in oklab, var(--cyan) 45%, transparent); }
  :global(.rag-body) { height: 380px; overflow-y: auto; padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; }
  :global(.rag-empty) { margin: auto; max-width: 40ch; text-align: center; color: var(--muted); font-size: 15px; line-height: 1.6; }
  :global(.rag-q) {
    align-self: flex-end; max-width: 85%;
    padding: 10px 16px; border-radius: 18px 18px 4px 18px;
    background: var(--grad); color: #fff; font-weight: 500; font-size: 15px;
  }
  :global(.rag-a) { align-self: flex-start; max-width: 92%; display: grid; gap: 10px; }
  :global(.rag-hit) {
    padding: 14px 16px; border-radius: 4px 18px 18px 18px;
    background: var(--surface); border: 1px solid var(--line);
    font-size: 14.5px; line-height: 1.6; color: var(--muted);
  }
  :global(.rag-meta) { display: flex; justify-content: space-between; gap: 10px; margin-top: 8px; font-family: var(--font-mono); font-size: 11.5px; }
  :global(.rag-src) { color: var(--cyan); font-weight: 600; }
  :global(.rag-score) { color: var(--dim); }
  :global(.rag-mark) { background: color-mix(in oklab, var(--yellow) 40%, transparent); color: var(--ink); border-radius: 4px; padding: 0 2px; }
  :global(.rag-abstain) {
    padding: 14px 16px; border-radius: 4px 18px 18px 18px; font-size: 14.5px; line-height: 1.6;
    color: var(--muted); border: 1px dashed color-mix(in oklab, var(--orange) 60%, transparent);
    background: color-mix(in oklab, var(--orange) 8%, transparent);
  }
  :global(.rag-abstain strong) { color: var(--orange); }
  :global(.rag-sugs) { display: flex; gap: 8px; overflow-x: auto; padding: 12px 22px 0; scrollbar-width: none; }
  :global(.rag-sug) {
    flex: none; padding: 8px 14px; border-radius: 999px; cursor: pointer;
    font-size: 13px; color: var(--muted); background: var(--surface); border: 1px solid var(--line-strong);
    transition: color .2s, border-color .2s;
  }
  :global(.rag-sug:hover) { color: var(--ink); border-color: var(--cyan); }
  :global(.rag-form) { display: flex; gap: 10px; padding: 14px 22px 20px; }
  :global(.rag-form input) {
    flex: 1; min-width: 0; padding: 14px 18px; border-radius: 999px;
    font: inherit; font-size: 15px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line-strong);
  }
  :global(.rag-form input:focus) { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 4px color-mix(in oklab, var(--cyan) 20%, transparent); }
  :global(.rag-form button) {
    flex: none; width: 50px; height: 50px; border-radius: 50%; cursor: pointer;
    font-size: 20px; font-weight: 700; color: #fff; background: var(--grad); border: 0;
  }
  :global(.rag-form button:disabled) { opacity: .45; cursor: not-allowed; }

  /* ── Pipeline visualizer ── */
  :global(.arch) {
    padding: 28px; border-radius: 32px;
    background: var(--surface); border: 1px solid var(--line);
    backdrop-filter: blur(18px);
  }
  @media (min-width: 768px) { :global(.arch) { padding: 40px; } }
  :global(.arch-head) { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  :global(.arch-kicker) { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .16em; color: var(--pink); }
  :global(.arch-title) { margin-top: 8px; font-family: var(--font-display); font-weight: 800; font-size: clamp(28px, 3.6vw, 44px); letter-spacing: -.035em; line-height: 1.05; color: var(--ink); }
  :global(.arch-stats) { display: flex; gap: 16px; font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  :global(.arch-stats b) { font-family: var(--font-display); font-size: 26px; margin-right: 4px; }
  :global(.arch-flow) { margin-top: 32px; display: grid; gap: 10px; grid-template-columns: 1fr; }
  @media (min-width: 1024px) {
    :global(.arch-flow) { grid-template-columns: repeat(11, auto); align-items: stretch; }
  }
  :global(.arch-link) { display: none; }
  @media (min-width: 1024px) {
    :global(.arch-link) { display: block; align-self: center; width: 18px; height: 2px; background: var(--line-strong); }
  }
  :global(.arch-node) {
    text-align: left; cursor: pointer;
    display: grid; gap: 4px; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center;
    padding: 14px 16px; border-radius: 20px;
    background: var(--bg-elev); border: 1px solid var(--line);
    transition: border-color .25s, transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s;
  }
  @media (min-width: 1024px) { :global(.arch-node) { grid-template-columns: 1fr; } }
  :global(.arch-node:hover), :global(.arch-node.on) { border-color: var(--c); transform: translateY(-3px); box-shadow: 0 18px 40px -22px var(--c); }
  :global(.arch-num) {
    grid-row: span 2; width: 30px; height: 30px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    color: var(--c); border: 1.5px solid var(--c);
  }
  :global(.arch-node.on .arch-num) { background: var(--c); color: #fff; }
  @media (min-width: 1024px) { :global(.arch-num) { grid-row: auto; margin-bottom: 6px; } }
  :global(.arch-label) { font-weight: 700; font-size: 15.5px; color: var(--ink); }
  :global(.arch-tech) { font-family: var(--font-mono); font-size: 11.5px; color: var(--dim); }
  :global(.arch-detail) {
    margin-top: 22px; padding: 24px 26px; border-radius: 22px;
    background: color-mix(in oklab, var(--c) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--c) 40%, transparent);
  }
  :global(.arch-detail-label) { font-family: var(--font-display); font-weight: 800; font-size: 24px; letter-spacing: -.02em; color: var(--c); }
  :global(.arch-what) { margin-top: 8px; font-size: 16.5px; line-height: 1.6; color: var(--ink); }
  :global(.arch-why) { margin-top: 10px; font-size: 15px; line-height: 1.6; color: var(--muted); }
  :global(.arch-why span) { font-family: var(--font-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: .14em; color: var(--c); margin-right: 10px; }
</style>
