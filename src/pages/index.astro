---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { person, proofPoints, experiences, skillGroups, marqueeA, marqueeB, languages } from '../data/profile';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const [hero, ...rest] = featured;
const others = all.filter((p) => !p.data.featured);

const pipeline = [
  { step: 'Transcribe', tech: 'faster-whisper · GPU', color: 'var(--cyan)' },
  { step: 'Hybrid search', tech: 'BM25 + multilingual E5 · RRF', color: 'var(--violet)' },
  { step: 'Rerank', tech: 'cross-encoder', color: 'var(--pink)' },
  { step: 'Answer + verify', tech: 'Qwen 2.5 3B · Ollama · cited to the second', color: 'var(--orange)' },
];
---

<BaseLayout title="Mohamed Abidi — AI Engineer & Data Scientist" bleed>

  <!-- ═════════════════════════════ HERO ═════════════════════════════ -->
  <section class="relative min-h-[100svh] flex items-center overflow-hidden pt-28 pb-16">
    <div class="mesh" aria-hidden="true">
      <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div><div class="blob b4"></div>
    </div>
    <div class="grid-lines" aria-hidden="true"></div>

    <div class="wrap relative z-10 grid lg:grid-cols-[1.25fr_0.75fr] gap-14 items-center">
      <div>
        <div class="rise rise-1 inline-flex flex-wrap items-center gap-3 pl-3 pr-4 py-2 rounded-full" style="background: var(--surface); border: 1px solid var(--line-strong); backdrop-filter: blur(12px);">
          <span class="live-dot" aria-hidden="true"></span>
          <span class="text-[13.5px] font-medium" style="color: var(--ink);">Open to a {person.lookingFor} · {person.availability}</span>
          <span class="hidden sm:inline font-mono text-[12px]" style="color: var(--dim);">TN · DE · CH · FR</span>
        </div>

        <h1 class="h-display mt-8 text-[clamp(64px,13vw,176px)]">
          <span class="rise rise-2 block" style="color: var(--ink);">Mohamed</span>
          <span class="rise rise-3 inline-block grad-text pb-2 pr-2">Abidi.</span>
        </h1>

        <p class="rise rise-4 mt-6 font-display font-semibold tracking-[-0.025em] leading-[1.15] text-[clamp(24px,3.1vw,40px)] max-w-[22ch]" style="color: var(--ink);">
          I build
          <span class="rotator" data-rotator>
            <span class="grad-text">RAG pipelines</span>
            <span class="grad-text">multilingual search</span>
            <span class="grad-text">vision prototypes</span>
            <span class="grad-text">LLM evaluations</span>
          </span>
          <br /> that cite their sources.
        </p>

        <p class="rise rise-5 mt-6 text-[17px] md:text-[18px] leading-relaxed max-w-[58ch]" style="color: var(--muted);">
          {person.status}. Specializing in RAG and generative AI for document analysis, with Arabic / French NLP and information retrieval.
        </p>

        <div class="rise rise-6 mt-9 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-grad">
            See the work
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0 6-6m-6 6-6-6"/></svg>
          </a>
          <a href="/contact" class="btn btn-ghost">Let's talk</a>
          <a href={person.cv} download="Mohamed-Abidi-CV.pdf" class="btn btn-ghost sm:hidden">CV ↓</a>
        </div>
      </div>

      <!-- Pipeline card -->
      <div class="rise rise-5 relative">
        <div class="orbit" aria-hidden="true"></div>
        <div class="card p-6 md:p-7" style="--acc: var(--violet);">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[12px] uppercase tracking-[.16em]" style="color: var(--dim);">How I build RAG</span>
            <span class="chip chip-acc">ResearchMind · video</span>
          </div>
          <ol class="mt-6 space-y-3">
            {pipeline.map((s, i) => (
              <li class="pipe-step" style={`--c: ${s.color};`}>
                <span class="pipe-num">{i + 1}</span>
                <span>
                  <span class="block font-semibold text-[15.5px]" style="color: var(--ink);">{s.step}</span>
                  <span class="block font-mono text-[12.5px]" style="color: var(--muted);">{s.tech}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="mt-6 grid grid-cols-2 gap-3">
            <div class="mini-stat" style="--c: var(--violet);"><span class="stat-value text-[30px]" style="color: var(--violet);">0.95</span><span>Recall@3</span></div>
            <div class="mini-stat" style="--c: var(--pink);"><span class="stat-value text-[30px]" style="color: var(--pink);">0.85</span><span>MRR · hard set</span></div>
          </div>
        </div>
      </div>
    </div>

    <a href="#work" class="scroll-cue hidden lg:flex" aria-label="Scroll to projects">
      <span></span>
    </a>
  </section>

  <!-- ═════════════════════════════ MARQUEE ═════════════════════════════ -->
  <section class="py-10 space-y-4" aria-label="Technologies" style="border-block: 1px solid var(--line);">
    <div class="marquee">
      <div class="marquee-track">
        {[...marqueeA, ...marqueeA].map((t, i) => (
          <span class="tech-pill" style={`--c: ${['var(--violet)','var(--pink)','var(--orange)','var(--cyan)'][i % 4]};`}>{t}</span>
        ))}
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track reverse">
        {[...marqueeB, ...marqueeB].map((t, i) => (
          <span class="tech-pill" style={`--c: ${['var(--lime)','var(--cyan)','var(--violet)','var(--pink)'][i % 4]};`}>{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ PROOF ═════════════════════════════ -->
  <section class="section !pb-0">
    <div class="wrap">
      <p class="eyebrow reveal">Measured, not guessed</p>
      <h2 class="h-section mt-4 max-w-[18ch] reveal d1">I evaluate what I build.</h2>
      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-4">
        {proofPoints.map((p, i) => (
          <div class:list={["card lift p-6 md:p-7 reveal", `d${i + 1}`]} style={`--acc: ${p.color};`}>
            <span class="acc-bar" aria-hidden="true"></span>
            <div class="stat-value text-[clamp(44px,6vw,72px)]" style={`color: ${p.color};`}>{p.value}</div>
            <div class="mt-3 font-semibold text-[15px]" style="color: var(--ink);">{p.label}</div>
            <div class="mt-1 text-[13px] font-mono" style="color: var(--dim);">{p.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ WORK ═════════════════════════════ -->
  <section id="work" class="section scroll-mt-24">
    <div class="wrap">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <p class="eyebrow reveal">Selected work</p>
          <h2 class="h-section mt-4 reveal d1">Projects &amp; <span class="grad-text">case studies</span></h2>
        </div>
        <a href="/projects" class="btn btn-ghost self-start md:self-auto reveal d2">All {all.length} projects →</a>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {hero && (
          <div class="md:col-span-2 lg:row-span-2 reveal">
            <ProjectCard project={hero} index={1} big />
          </div>
        )}
        {rest.map((p, i) => (
          <div class:list={["reveal", `d${(i % 3) + 1}`]}>
            <ProjectCard project={p} index={i + 2} />
          </div>
        ))}
      </div>

      {others.length > 0 && (
        <p class="mt-8 text-[15px] reveal" style="color: var(--muted);">
          Also built:
          {others.map((p, i) => (
            <>
              <a href={`/projects/${p.id}`} class="also-link">{p.data.title}</a>{i < others.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <!-- ═════════════════════════════ EXPERIENCE ═════════════════════════════ -->
  <section class="section relative overflow-hidden" style="background: var(--grad-soft);">
    <div class="wrap">
      <p class="eyebrow reveal">Experience</p>
      <h2 class="h-section mt-4 reveal d1">Two industrial internships, <span class="grad-text">2026</span>.</h2>

      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        {experiences.map((e, i) => (
          <article class:list={["card lift p-7 md:p-9 reveal", `d${i + 1}`]} style={`--acc: ${e.color};`}>
            <span class="acc-bar" aria-hidden="true"></span>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="chip chip-acc">{e.period}</span>
              {e.repo && <a href={e.repo} target="_blank" rel="noopener noreferrer" class="text-[13px] font-mono underline-offset-4 hover:underline" style="color: var(--muted);">GitHub ↗</a>}
            </div>
            <h3 class="mt-5 font-display font-extrabold text-[28px] md:text-[32px] tracking-[-0.03em] leading-tight" style="color: var(--ink);">{e.company}</h3>
            <p class="mt-1 text-[15px]" style="color: var(--muted);">{e.unit} · <span style="color: var(--ink);">{e.role}</span></p>
            <p class="mt-4 font-semibold" style={`color: ${e.color};`}>{e.focus}</p>
            <ul class="mt-4 space-y-2.5">
              {e.bullets.map((b) => (
                <li class="flex gap-3 text-[15px] leading-relaxed" style="color: var(--muted);">
                  <span class="mt-[9px] w-1.5 h-1.5 rounded-full shrink-0" style={`background: ${e.color};`}></span>{b}
                </li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-2">{e.tags.map((t) => <span class="chip">{t}</span>)}</div>
            {e.project && <a href={e.project} class="mt-6 inline-flex font-semibold text-[15px] no-underline" style={`color: ${e.color};`}>Read the case study →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ TOOLKIT ═════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12">
        <div class="lg:sticky lg:top-32 self-start">
          <p class="eyebrow reveal">Toolkit</p>
          <h2 class="h-section mt-4 reveal d1">What I work <span class="grad-text">with</span>.</h2>
          <p class="mt-5 text-[17px] leading-relaxed max-w-[44ch] reveal d2" style="color: var(--muted);">
            {person.goal}
          </p>
          <div class="mt-8 space-y-4 max-w-sm reveal d3">
            {languages.map((l) => (
              <div>
                <div class="flex justify-between text-[14px]"><span class="font-semibold" style="color: var(--ink);">{l.name}</span><span class="font-mono" style="color: var(--dim);">{l.level}</span></div>
                <div class="mt-2 h-2 rounded-full overflow-hidden" style="background: var(--line);">
                  <div class="h-full rounded-full" style={`width: ${l.pct}%; background: var(--grad);`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          {skillGroups.map((g, i) => (
            <div class:list={["card lift p-6 reveal", i === 0 && "sm:col-span-2", `d${(i % 3) + 1}`]} style={`--acc: ${g.color};`}>
              <span class="acc-bar" aria-hidden="true"></span>
              <h3 class="font-display font-bold text-[20px] tracking-tight" style={`color: ${g.color};`}>{g.name}</h3>
              <div class="mt-4 flex flex-wrap gap-2">{g.items.map((s) => <span class="chip">{s}</span>)}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ LAB ═════════════════════════════ -->
  <section class="section !pt-0">
    <div class="wrap">
      <a href="/lab" class="card lab-teaser group block p-8 md:p-12 no-underline reveal" style="--acc: var(--cyan);">
        <span class="acc-bar" aria-hidden="true"></span>
        <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-10 items-center">
          <div>
            <p class="eyebrow" style="color: var(--cyan);">AI Lab</p>
            <h2 class="mt-4 font-display font-extrabold text-[clamp(32px,4.4vw,52px)] tracking-[-0.035em] leading-[1.02]" style="color: var(--ink);">
              Ask my CV a question.
            </h2>
            <p class="mt-4 text-[17px] leading-relaxed max-w-[48ch]" style="color: var(--muted);">
              A small extractive search engine that runs in your browser: BM25-style ranking, source citations and abstention — no LLM, so nothing is invented.
            </p>
            <span class="mt-7 btn btn-grad">Open the lab →</span>
          </div>
          <div class="fake-input" aria-hidden="true">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full" style="background: var(--pink);"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background: var(--yellow);"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background: var(--lime);"></span>
            </div>
            <p class="mt-5 font-mono text-[14px]" style="color: var(--ink);"><span style="color: var(--cyan);">›</span> What did he evaluate in ResearchMind?</p>
            <p class="mt-4 text-[14px] leading-relaxed" style="color: var(--muted);">Recall@3 = 0.95 and MRR = 0.85 on the hard set; 100% of off-topic questions rejected…</p>
            <span class="chip chip-acc mt-4" style="--acc: var(--cyan);">source · Projects / ResearchMind</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═════════════════════════════ CTA ═════════════════════════════ -->
  <section class="section !pt-0">
    <div class="wrap">
      <div class="cta relative overflow-hidden rounded-[36px] px-7 py-14 md:px-16 md:py-20 reveal">
        <div class="cta-shine" aria-hidden="true"></div>
        <p class="font-mono text-[12px] uppercase tracking-[.18em] text-white/80">PFE · 6 months · {person.availability}</p>
        <h2 class="mt-5 h-display text-white text-[clamp(40px,7vw,96px)] max-w-[14ch]">Let's build something reliable.</h2>
        <p class="mt-6 text-[17px] md:text-[19px] text-white/85 max-w-[52ch]">
          Looking for an end-of-studies internship in RAG, NLP or computer vision — in {person.countries.slice(0, -1).join(', ')} or {person.countries.at(-1)}.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${person.email}`} class="btn cta-btn-solid">{person.email}</a>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="btn cta-btn-line">LinkedIn ↗</a>
          <a href={person.cv} download="Mohamed-Abidi-CV.pdf" class="btn cta-btn-line">Download CV ↓</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .orbit {
    position: absolute; inset: -14%; z-index: -1; border-radius: 50%;
    background: conic-gradient(from 0deg, var(--violet), var(--pink), var(--orange), var(--cyan), var(--violet));
    filter: blur(60px); opacity: .35;
    animation: spin-slow 18s linear infinite;
  }
  .pipe-step {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 14px; border-radius: 16px;
    background: color-mix(in oklab, var(--c) 9%, transparent);
    border: 1px solid color-mix(in oklab, var(--c) 28%, transparent);
  }
  .pipe-num {
    flex: none; width: 30px; height: 30px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    background: var(--c); color: #fff;
  }
  :global(html:not(.dark)) .pipe-num { color: #fff; }
  .mini-stat {
    display: flex; flex-direction: column; gap: 4px;
    padding: 14px 16px; border-radius: 16px;
    border: 1px solid color-mix(in oklab, var(--c) 30%, transparent);
    font-size: 12.5px; color: var(--muted);
  }
  .scroll-cue {
    position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%);
    width: 26px; height: 42px; border-radius: 999px; border: 1.5px solid var(--line-strong);
    justify-content: center; padding-top: 8px; z-index: 10;
  }
  .scroll-cue span { width: 4px; height: 8px; border-radius: 4px; background: var(--grad); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }

  .tech-pill {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 22px; border-radius: 999px;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(17px, 2vw, 22px); letter-spacing: -0.02em;
    color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    white-space: nowrap;
  }
  .tech-pill::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--c); box-shadow: 0 0 14px var(--c); }

  .also-link { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--pink); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .also-link:hover { color: var(--pink); }

  .fake-input {
    padding: 22px; border-radius: 22px;
    background: var(--bg-elev); border: 1px solid var(--line);
    box-shadow: 0 30px 60px -35px var(--cyan);
    transition: transform .5s cubic-bezier(.16,1,.3,1);
  }
  .lab-teaser:hover .fake-input { transform: rotate(-1.5deg) translateY(-4px); }

  .cta { background: linear-gradient(120deg, #5B2EE8 0%, #D9127A 50%, #F26A1B 100%); }
  .cta-shine {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(600px circle at 85% 10%, rgba(255,255,255,.28), transparent 60%),
      radial-gradient(500px circle at 10% 110%, rgba(76,227,255,.35), transparent 60%);
  }
  .cta-btn-solid { background: #fff; color: #15111F; }
  .cta-btn-solid:hover { box-shadow: 0 16px 40px -14px rgba(0,0,0,.5); }
  .cta-btn-line { color: #fff; border: 1.5px solid rgba(255,255,255,.55); }
  .cta-btn-line:hover { background: rgba(255,255,255,.12); }
</style>
