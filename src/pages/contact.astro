---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Mail, MapPin } from 'lucide-react';
---

<BaseLayout title="Contact | Mohamed Abidi">
  <div class="container mx-auto px-4 max-w-3xl">
    
    <header class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="section-line"></div>
        <span class="text-[11px] tracking-[0.16em] uppercase font-mono font-semibold" style="color: var(--color-accent);">Direct Channel</span>
        <div class="section-line"></div>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4" style="color: var(--text-primary);">
        Get in Touch
      </h1>
      <p class="text-lg md:text-xl" style="color: var(--text-muted);">
        Available for AI Engineering, Machine Learning and Software Engineering opportunities.
      </p>
    </header>

    <div class="grid md:grid-cols-5 gap-10 items-start">
      
      <div class="md:col-span-3">
        <form
          class="space-y-5 p-6 md:p-8 rounded-2xl border transition-colors duration-300"
          style="background: var(--bg-card); border-color: var(--border-card); box-shadow: var(--card-shadow);"
          action="mailto:Mohamed.abidi@esprim.tn"
          method="GET"
        >
          <div class="space-y-1.5">
            <label for="name" class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-primary);">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your name"
              class="w-full rounded-lg px-4 py-2.5 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
              style="background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-primary);"
            />
          </div>
          
          <div class="space-y-1.5">
            <label for="email" class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-primary);">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your.email@example.com"
              class="w-full rounded-lg px-4 py-2.5 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
              style="background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-primary);"
            />
          </div>
          
          <div class="space-y-1.5">
            <label for="message" class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-primary);">Message</label>
            <textarea
              id="message"
              name="body"
              rows="5"
              required
              placeholder="How can we collaborate on your AI systems?"
              class="w-full rounded-lg px-4 py-2.5 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]"
              style="background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-primary);"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-full font-semibold text-sm transition-transform cursor-pointer"
            style="background: var(--btn-primary-bg); color: var(--btn-primary-text); box-shadow: var(--card-shadow);"
            onmouseover="this.style.transform='translateY(-1px)'"
            onmouseout="this.style.transform='translateY(0)'"
          >
            Send Message
          </button>
        </form>
      </div>

      <div class="md:col-span-2 space-y-8">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider mb-4 font-mono" style="color: var(--color-accent);">Direct Contact</h3>
          <div class="space-y-3.5">
            <a
              href="mailto:Mohamed.abidi@esprim.tn"
              class="flex items-center gap-3 text-sm transition-colors"
              style="color: var(--text-muted); text-decoration: none;"
              onmouseover="this.style.color='var(--color-accent)'"
              onmouseout="this.style.color='var(--text-muted)'"
            >
              <Mail className="w-4 h-4 flex-shrink-0 text-[var(--color-accent)]" />
              <span class="break-all font-mono text-xs">Mohamed.abidi@esprim.tn</span>
            </a>
            <div class="flex items-center gap-3 text-sm" style="color: var(--text-muted);">
              <MapPin className="w-4 h-4 flex-shrink-0 text-[var(--color-accent)]" />
              <span class="text-xs">Tunisia · Open to EU/CH relocation</span>
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider mb-4 font-mono" style="color: var(--color-accent);">Profiles</h3>
          <div class="flex flex-col gap-2.5">
            <a
              href="https://github.com/Mohamed-abidi-95"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-xs font-semibold p-2.5 rounded-lg border transition-colors"
              style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-primary); text-decoration: none;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              <span>GitHub / Mohamed-abidi-95</span>
            </a>
            <a
              href="https://linkedin.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-xs font-semibold p-2.5 rounded-lg border transition-colors"
              style="background: var(--bg-card); border-color: var(--border-color); color: var(--text-primary); text-decoration: none;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              <span>LinkedIn Profile</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
