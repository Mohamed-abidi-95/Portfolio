---
import BaseLayout from '../layouts/BaseLayout.astro';
import { person } from '../data/profile';

const links = [
  { label: 'Email', value: person.email, href: `mailto:${person.email}`, color: 'var(--pink)', ext: false },
  { label: 'LinkedIn', value: 'in/mohamed-abidi95000', href: person.linkedin, color: 'var(--violet)', ext: true },
  { label: 'GitHub', value: person.githubHandle, href: person.github, color: 'var(--orange)', ext: true },
  { label: 'CV (PDF)', value: 'Mohamed-Abidi-CV.pdf', href: person.cv, color: 'var(--cyan)', ext: false, download: true },
];
---

<BaseLayout title="Contact — Mohamed Abidi">
  <div class="mesh" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>

  <div class="wrap relative z-10 pb-24">
    <header class="max-w-4xl">
      <p class="eyebrow rise rise-1">Contact</p>
      <h1 class="h-display mt-5 text-[clamp(56px,10vw,136px)] rise rise-2">
        <span style="color: var(--ink);">Say </span><span class="grad-text">hello.</span>
      </h1>
      <p class="mt-6 text-[clamp(18px,2vw,22px)] leading-snug max-w-[48ch] rise rise-3" style="color: var(--muted);">
        I'm looking for a {person.lookingFor} {person.availability}, in RAG, NLP or computer vision. The fastest way to reach me is email.
      </p>
    </header>

    <div class="mt-14 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <!-- Big email card -->
      <div class="card p-8 md:p-12 rise rise-4" style="--acc: var(--pink);">
        <span class="acc-bar" aria-hidden="true"></span>
        <p class="font-mono text-[12px] uppercase tracking-[.16em]" style="color: var(--dim);">Email me</p>
        <a href={`mailto:${person.email}`} class="block mt-4 font-display font-extrabold text-[clamp(24px,3.6vw,44px)] tracking-[-0.035em] leading-tight break-all grad-text no-underline">
          {person.email}
        </a>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${person.email}?subject=PFE%20opportunity`} class="btn btn-grad">Write an email →</a>
          <button type="button" id="copy-email" class="btn btn-ghost" data-email={person.email}>
            <span id="copy-label">Copy address</span>
          </button>
        </div>

        <form id="draft-form" class="mt-12 grid gap-4" data-email={person.email}>
          <p class="font-mono text-[12px] uppercase tracking-[.16em]" style="color: var(--dim);">Or draft it here (opens your mail app)</p>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="field"><span>Your name</span><input name="name" required autocomplete="name" placeholder="Jane Doe — Company" /></label>
            <label class="field"><span>Your email</span><input type="email" name="email" autocomplete="email" placeholder="jane@company.com" /></label>
          </div>
          <label class="field"><span>Message</span><textarea name="message" rows="5" required placeholder="Hi Mohamed, we have a PFE topic on…"></textarea></label>
          <button type="submit" class="btn btn-grad justify-self-start">Open in my mail app</button>
        </form>
      </div>

      <!-- Link cards -->
      <div class="grid gap-4 content-start">
        {links.map((l, i) => (
          <a
            href={l.href}
            target={l.ext ? '_blank' : undefined}
            rel={l.ext ? 'noopener noreferrer' : undefined}
            download={l.download ? 'Mohamed-Abidi-CV.pdf' : undefined}
            class:list={["card group flex items-center justify-between gap-4 p-6 no-underline rise", `rise-${i + 3}`]}
            style={`--acc: ${l.color};`}
          >
            <span class="acc-bar" aria-hidden="true"></span>
            <span>
              <span class="block font-mono text-[12px] uppercase tracking-[.16em]" style="color: var(--dim);">{l.label}</span>
              <span class="block mt-1 font-display font-bold text-[20px] md:text-[22px] tracking-tight break-all" style="color: var(--ink);">{l.value}</span>
            </span>
            <span class="link-arrow" aria-hidden="true">{l.download ? '↓' : '↗'}</span>
          </a>
        ))}

        <div class="card p-6" style="--acc: var(--lime);">
          <span class="acc-bar" aria-hidden="true"></span>
          <div class="flex items-center gap-3"><span class="live-dot" aria-hidden="true"></span><span class="font-semibold" style="color: var(--ink);">Open to opportunities</span></div>
          <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--muted);">
            Based in {person.location}. Open to a PFE in {person.countries.join(', ')}.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .field { display: grid; gap: 8px; }
  .field span { font-size: 13px; font-weight: 600; color: var(--ink); }
  .field input, .field textarea {
    width: 100%; padding: 14px 16px; border-radius: 16px;
    font: inherit; font-size: 15px; color: var(--ink);
    background: var(--bg-elev); border: 1px solid var(--line-strong);
    transition: border-color .2s, box-shadow .2s;
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--dim); }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--pink); box-shadow: 0 0 0 4px color-mix(in oklab, var(--pink) 20%, transparent); }
  .link-arrow {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 50%; font-size: 20px;
    border: 1px solid var(--line-strong); color: var(--ink);
    transition: background .3s, color .3s, border-color .3s, transform .4s cubic-bezier(.16,1,.3,1);
  }
  .group:hover .link-arrow { background: var(--acc); border-color: var(--acc); color: #fff; transform: rotate(-12deg) scale(1.06); }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('draft-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = new FormData(form);
      var name = String(f.get('name') || '').trim();
      var from = String(f.get('email') || '').trim();
      var msg = String(f.get('message') || '').trim();
      var subject = 'PFE opportunity — ' + name;
      var body = msg + '\n\n— ' + name + (from ? ' (' + from + ')' : '');
      window.location.href = 'mailto:' + form.getAttribute('data-email') +
        '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  })();

  (function () {
    var btn = document.getElementById('copy-email');
    var label = document.getElementById('copy-label');
    if (!btn || !label) return;
    btn.addEventListener('click', function () {
      var email = btn.getAttribute('data-email');
      function done() { label.textContent = 'Copied ✓'; setTimeout(function () { label.textContent = 'Copy address'; }, 1800); }
      if (navigator.clipboard) navigator.clipboard.writeText(email).then(done, function () { label.textContent = email; });
      else label.textContent = email;
    });
  })();
</script>
