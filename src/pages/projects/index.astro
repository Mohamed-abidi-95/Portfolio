---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => {
  const order = ['ai-grc', 'etic-label-inspection', 'omnutrition', 'cyberhunter'];
  return order.indexOf(a.id) - order.indexOf(b.id);
});

const categories = ["All", ...new Set(projects.map(p => p.data.category))];
---

<BaseLayout title="Projects | Mohamed Abidi">
  <div class="container mx-auto px-4 max-w-5xl">
    
    <header class="mb-12 text-center md:text-left">
      <div class="flex items-center justify-center md:justify-start gap-3 mb-3">
        <div class="section-line"></div>
        <span class="text-[11px] tracking-[0.16em] uppercase font-mono font-semibold" style="color: var(--color-accent);">Portfolio</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4" style="color: var(--text-primary);">Projects</h1>
      <p class="text-lg md:text-xl" style="color: var(--text-muted);">A selection of production systems and engineering case studies I've built.</p>
    </header>

    {/* Filter Buttons */}
    <div class="mb-10 flex flex-wrap gap-2 justify-center md:justify-start" id="filter-container">
      {categories.map((cat, i) => (
        <button 
          class={`px-4 py-1.5 rounded-full text-xs font-semibold font-mono tracking-wide transition-colors border cursor-pointer ${
            i === 0 
              ? 'filter-active' 
              : 'filter-inactive'
          }`}
          data-filter={cat === "All" ? "all" : cat}
          style={i === 0 ? {
            background: 'var(--color-accent)',
            color: 'var(--btn-primary-text)',
            borderColor: 'var(--color-accent)',
          } : {
            background: 'var(--bg-card)',
            color: 'var(--text-muted)',
            borderColor: 'var(--border-color)',
          }}
        >
          {cat}
        </button>
      ))}
    </div>

    {/* Projects Grid */}
    <div class="grid md:grid-cols-2 gap-6" id="projects-grid">
      {sortedProjects.map((project, idx) => (
        <div
          class="project-card rounded-2xl border flex flex-col transition-all duration-300 overflow-hidden"
          data-category={project.data.category}
          style={{
            background: 'var(--bg-card)',
            borderColor: 'var(--border-card)',
            boxShadow: 'var(--card-shadow)',
          }}
        >
          <a href={`/projects/${project.id}`} class="flex-grow p-6 md:p-8 flex flex-col" style="text-decoration: none;">
            <div class="flex items-center justify-between gap-3 mb-4">
              <span
                class="px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold"
                style={{
                  background: 'var(--color-accent-soft)',
                  color: 'var(--color-accent)',
                  border: '1px solid var(--color-accent-border)',
                }}
              >
                {project.data.category}
              </span>
              <span class="text-xs font-mono" style={{ color: 'var(--text-dim)' }}>
                {project.data.context}
              </span>
            </div>
            
            <h3 class="text-xl md:text-2xl font-bold mb-3 transition-colors hover:text-[var(--color-accent)]" style={{ color: 'var(--text-primary)' }}>
              {project.data.title}
            </h3>
            
            <p class="text-sm leading-relaxed mb-6 flex-grow" style={{ color: 'var(--text-muted)' }}>
              {project.data.subtitle}
            </p>
            
            <div class="flex flex-wrap gap-1.5 mt-auto pt-4" style={{ borderTop: '1px solid var(--border-color)' }}>
              {project.data.tags.slice(0, 5).map(tag => (
                <span
                  class="px-2 py-0.5 rounded text-[10px] font-mono"
                  style={{
                    background: 'var(--color-accent-soft)',
                    color: 'var(--color-accent)',
                    border: '1px solid var(--color-accent-border)',
                  }}
                >
                  {tag}
                </span>
              ))}
            </div>

            <div class="pt-4 mt-2 flex items-center gap-1.5 text-xs font-semibold" style={{ color: 'var(--color-accent)' }}>
              Read Case Study →
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('#filter-container button');
      const projectCards = document.querySelectorAll('.project-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.style.background = 'var(--bg-card)';
            b.style.color = 'var(--text-muted)';
            b.style.borderColor = 'var(--border-color)';
          });
          btn.style.background = 'var(--color-accent)';
          btn.style.color = 'var(--btn-primary-text)';
          btn.style.borderColor = 'var(--color-accent)';

          const filter = btn.getAttribute('data-filter');

          projectCards.forEach(card => {
            if (filter === 'all' || card.getAttribute('data-category') === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</BaseLayout>
