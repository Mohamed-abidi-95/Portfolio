---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { categories, categoryAccent } from '../../lib/accent';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const used = categories.filter((c) => projects.some((p) => p.data.category === c));
---

<BaseLayout title="Projects — Mohamed Abidi">
  <div class="mesh opacity-60" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div></div>

  <div class="wrap relative z-10 pb-24">
    <header class="max-w-3xl">
      <p class="eyebrow rise rise-1">Work</p>
      <h1 class="h-display mt-5 text-[clamp(52px,9vw,120px)] rise rise-2">
        <span style="color: var(--ink);">All </span><span class="grad-text">projects.</span>
      </h1>
      <p class="mt-6 text-[18px] leading-relaxed rise rise-3" style="color: var(--muted);">
        Internship prototypes and academic projects — RAG, multilingual search, computer vision and full-stack. Each one links to a short case study.
      </p>
    </header>

    <div class="mt-12 flex flex-wrap gap-2 rise rise-4" id="filters" role="group" aria-label="Filter projects by category">
      <button class="filter active" data-filter="all" style="--acc: var(--ink);" aria-pressed="true">All <span class="count">{projects.length}</span></button>
      {used.map((c) => (
        <button class="filter" data-filter={c} style={`--acc: ${categoryAccent[c]};`} aria-pressed="false">
          {c} <span class="count">{projects.filter((p) => p.data.category === c).length}</span>
        </button>
      ))}
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3" id="grid">
      {projects.map((p, i) => (
        <div class="proj reveal" data-category={p.data.category}>
          <ProjectCard project={p} index={i + 1} />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .filter {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 999px; cursor: pointer;
    font-size: 14px; font-weight: 600;
    color: var(--muted); background: var(--surface);
    border: 1px solid var(--line-strong);
    transition: color .2s, background .2s, border-color .2s, transform .2s;
  }
  .filter:hover { color: var(--ink); border-color: var(--acc); transform: translateY(-1px); }
  .filter .count { font-family: var(--font-mono); font-size: 12px; opacity: .7; }
  .filter.active { color: var(--bg); background: var(--acc); border-color: var(--acc); }
  .filter.active .count { opacity: .85; }
</style>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('#filters .filter');
    var items = document.querySelectorAll('#grid .proj');
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.getAttribute('data-filter');
        btns.forEach(function (x) { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        items.forEach(function (it) {
          var show = f === 'all' || it.getAttribute('data-category') === f;
          it.style.display = show ? '' : 'none';
          if (show) it.classList.add('in');
        });
      });
    });
  })();
</script>
