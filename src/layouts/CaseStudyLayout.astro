---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { categoryAccent } from '../lib/accent';
import { Image } from 'astro:assets';
import ProjectMedia from '../components/ProjectMedia.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;
const acc = categoryAccent[d.category];

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];

const facts = [
  { k: 'Context', v: d.context },
  { k: 'Period', v: d.period },
  d.role && { k: 'Role', v: d.role },
  d.team && { k: 'Team', v: d.team },
].filter(Boolean) as { k: string; v: string }[];
---

<BaseLayout title={`${d.title} — Mohamed Abidi`} description={d.subtitle}>
  <div class="hero-glow" style={`--acc: ${acc};`} aria-hidden="true"></div>

  <article class="wrap relative z-10 pb-24" style={`--acc: ${acc};`}>
    <a href="/projects" class="back rise rise-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6"/></svg>
      All projects
    </a>

    <header class="mt-8 max-w-4xl">
      <span class="chip chip-acc rise rise-2">{d.category}</span>
      <h1 class="h-display mt-6 text-[clamp(46px,8vw,104px)] rise rise-3" style="color: var(--ink);">{d.title}</h1>
      <p class="mt-6 text-[clamp(19px,2.2vw,25px)] leading-snug max-w-[40ch] rise rise-4" style="color: var(--muted);">{d.subtitle}</p>
    </header>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 rise rise-5">
      {facts.map((f) => (
        <div class="fact">
          <div class="font-mono text-[11.5px] uppercase tracking-[.16em]" style="color: var(--dim);">{f.k}</div>
          <div class="mt-2 font-semibold text-[15.5px] leading-snug" style="color: var(--ink);">{f.v}</div>
        </div>
      ))}
    </div>

    {d.metrics && (
      <div class="mt-4 grid gap-4 grid-cols-2 lg:grid-cols-4 rise rise-6">
        {d.metrics.map((m) => (
          <div class="card p-6" style={`--acc: ${acc};`}>
            <span class="acc-bar" aria-hidden="true"></span>
            <div class="stat-value text-[clamp(38px,5vw,56px)]" style="color: var(--acc);">{m.value}</div>
            <div class="mt-2 text-[14px] leading-snug" style="color: var(--muted);">{m.label}</div>
          </div>
        ))}
      </div>
    )}

    <div class="mt-12 rise rise-6">
      <ProjectMedia project={project} sizes="(min-width: 1200px) 1120px, 100vw" eager />
      {!d.cover && (
        <p class="mt-3 text-[13px] font-mono" style="color: var(--dim);">Illustration — no public screenshot of this project yet.</p>
      )}
    </div>

    <div class="mt-14 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-12">
      <div class="prose-x max-w-[72ch] min-w-0 overflow-x-auto">
        <slot />
      </div>

      <aside class="lg:sticky lg:top-32 self-start space-y-5">
        <div class="card p-6" style={`--acc: ${acc};`}>
          <span class="acc-bar" aria-hidden="true"></span>
          <h2 class="font-mono text-[11.5px] uppercase tracking-[.16em]" style="color: var(--dim);">Stack</h2>
          <div class="mt-4 flex flex-wrap gap-2">{d.tags.map((t) => <span class="chip">{t}</span>)}</div>
          {(d.githubLink || d.demoLink) && (
            <div class="mt-6 flex flex-col gap-2">
              {d.githubLink && <a href={d.githubLink} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !justify-between">Source on GitHub <span aria-hidden="true">↗</span></a>}
              {d.demoLink && <a href={d.demoLink} target="_blank" rel="noopener noreferrer" class="btn btn-grad !justify-between">Live demo <span aria-hidden="true">↗</span></a>}
            </div>
          )}
        </div>
      </aside>
    </div>

    {d.gallery && d.gallery.length > 0 && (
      <section class="mt-20" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="font-display font-extrabold text-[clamp(28px,3.4vw,40px)] tracking-[-0.03em]" style="color: var(--ink);">
          In the <span class="grad-text">app</span>
        </h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {d.gallery.map((g, i) => (
            <figure class:list={["shot-card reveal", i === 0 && d.gallery!.length % 2 === 1 && "md:col-span-2", `d${(i % 3) + 1}`]}>
              <a href={g.src.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-[18px]" aria-label={`Open full-size: ${g.alt}`}>
                <Image src={g.src} alt={g.alt} widths={[600, 1000, 1600]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full h-auto block shot-img" />
              </a>
              <figcaption class="mt-3 text-[15px] leading-relaxed" style="color: var(--muted);">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {next && next.id !== project.id && (
      <a href={`/projects/${next.id}`} class="card next group mt-20 flex flex-col md:flex-row md:items-center justify-between gap-6 p-8 md:p-10 no-underline" style={`--acc: ${categoryAccent[next.data.category]};`}>
        <span class="acc-bar" aria-hidden="true"></span>
        <div>
          <div class="font-mono text-[12px] uppercase tracking-[.16em]" style="color: var(--dim);">Next project</div>
          <div class="mt-3 font-display font-extrabold text-[clamp(30px,4.5vw,52px)] tracking-[-0.035em] leading-none" style="color: var(--ink);">{next.data.title}</div>
          <div class="mt-3 text-[15px]" style="color: var(--muted);">{next.data.subtitle}</div>
        </div>
        <span class="next-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </article>
</BaseLayout>

<style>
  .hero-glow {
    position: absolute; top: -10vh; left: 50%; transform: translateX(-50%);
    width: min(1100px, 100%); height: 620px; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--acc) 40%, transparent), transparent);
    filter: blur(40px); opacity: .55; pointer-events: none; z-index: 0;
  }
  .back {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px 8px 10px; border-radius: 999px;
    font-size: 14px; font-weight: 500; text-decoration: none;
    color: var(--muted); border: 1px solid var(--line-strong); background: var(--surface);
    transition: color .2s, border-color .2s;
  }
  .back:hover { color: var(--ink); border-color: var(--acc); }
  .fact {
    padding: 18px 20px; border-radius: 20px;
    background: var(--surface); border: 1px solid var(--line);
    backdrop-filter: blur(12px);
  }
  .shot-card a { border: 1px solid var(--line-strong); background: var(--bg-elev); box-shadow: 0 24px 50px -32px var(--acc); }
  .shot-img { transition: transform .8s cubic-bezier(.16,1,.3,1); }
  .shot-card a:hover .shot-img { transform: scale(1.02); }
  .next-arrow {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 72px; height: 72px; border-radius: 50%;
    font-size: 30px; color: #fff; background: var(--acc);
    transition: transform .5s cubic-bezier(.16,1,.3,1);
  }
  .next:hover .next-arrow { transform: translateX(8px) rotate(-8deg); }
</style>
